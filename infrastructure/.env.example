# Copiar para .env e preencher os valores.
# Gerar um segredo forte (>= 32 caracteres), por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# URL base do frontend (usada nos links de recuperação de palavra-passe).
APP_BASE_URL=http://localhost:5173

# Email (SMTP) para os emails de recuperação de palavra-passe.
# Em produção, preencher com as credenciais reais do fornecedor de email.
# Sem SMTP_HOST/SMTP_USER/SMTP_PASS, o link é escrito nos logs da API.
MAIL_FROM=MyVontade <no-reply@myvontade.pt>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Apenas para desenvolvimento/testes: se true, o endpoint de recuperação
# devolve o token na resposta. NUNCA usar em produção.
EXPOSE_RESET_TOKEN=false

# Opcional (não usado no fluxo de autenticação atual por token próprio).
AUTH0_AUDIENCE=
AUTH0_ISSUER_BASE_URL=
